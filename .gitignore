# 런타임 워크스페이스/산출물 — DB 메타와 워크스페이스에만 존재, 커밋하지 않음
workspaces/
output/
# 글로벌 소스 (인터뷰 소스 확인용 — compose에서 bind mount). 기본 추천 문서만 커밋 관리
sources/*
!sources/default_architecture_guidelines.md

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/
dist/

# 환경/비밀
.env
.env.*
# LLM 실제 설정 (config.example.json만 커밋 — 프로바이더 키/모델은 로컬)
backend/planforge/config.json

# OS
Thumbs.db
.DS_Store
# SQLite 런타임 DB (기본 DATABASE_URL: 저장소 루트 data/planforge.db)
data/
*.db
*.db-wal
*.db-shm
# 스모크/테스트 산출물 (fixture 디렉토리 오염 방지)
_smoke_out/
