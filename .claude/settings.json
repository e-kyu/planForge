{
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(pip:*)",
      "Bash(uv:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(python:*)",
      "PowerShell(pytest:*)",
      "PowerShell(pip:*)",
      "PowerShell(uv:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./backend/planforge/config.json)",
      "Read(./data/**)",
      "Read(./**/*.db)",
      "Read(./**/*.db-wal)",
      "Read(./**/*.db-shm)",
      "Edit(./.env*)",
      "Edit(./backend/planforge/config.json)",
      "Edit(./data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_ssot.py\""
          }
        ]
      }
    ]
  }
}